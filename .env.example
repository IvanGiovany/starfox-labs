# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Add the same variables in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (use the publishable key, never the secret one)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Newsletter (Phase 6): a random server-only secret. Put it in .env.local and in Vercel's
# Production environment only (not Preview). The database stores only its SHA-256
# (private.newsletter_settings). Never prefix it with NEXT_PUBLIC_.
NEWSLETTER_SECRET=
