# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Add the same variables in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (use the publishable key, never the secret one)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, local testing only (not on Vercel): "on" shows the end-of-article
# sign-up prompt, which stays off on the live site until Phase 5 (lib/features.ts).
# NEXT_PUBLIC_SIGN_UP_PROMPT=on
